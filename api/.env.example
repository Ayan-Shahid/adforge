# Copy to api/.env and fill in. NEVER commit the real file.
ANTHROPIC_API_KEY=sk-ant-...
# Neon / Supabase Postgres connection string (use sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Secret for the admin dashboard (any long random string)
ADMIN_TOKEN=change-me
# Optional
MODEL=claude-haiku-5-5
MAX_TOKENS=1400
HISTORY_WINDOW=24
